[Unit]
Description=domain-services busca un tag nuevo cada 10 minutos

# install.sh la enciende en el STEP 7, así que un redeploy deja el auto-deploy andando sin
# ningún paso extra. Para apagarlo:
#   sudo systemctl disable --now domain-auto-deploy.timer

[Timer]
OnCalendar=*:0/10
Persistent=true
RandomizedDelaySec=60
Unit=domain-auto-deploy.service

[Install]
WantedBy=timers.target
