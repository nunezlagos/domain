# ============================================================
# domain (cliente) — variables que entienden el instalador y los hooks
# ------------------------------------------------------------
# Este archivo es un EJEMPLO versionado. El archivo real que lee el cliente es:
#     ~/.config/domain/install.env      (Linux/macOS)
#     %APPDATA%\domain\install.env      (Windows)
#
# Lo genera `domain-install` con permisos 0600. Si lo creás a mano, poné vos el
# modo — puede terminar conteniendo tu API key:
#     chmod 600 ~/.config/domain/install.env
# ============================================================

# ------------------------------------------------------------
# 1. Lo que el instalador PERSISTE
# ------------------------------------------------------------
# Son exactamente estas dos, y son las únicas que `domain-install` escribe
# (envstore.go, saveEnv). Se guardan para no re-preguntarlas en cada corrida.

# URL del VPS donde corre el server MCP.
# Va un PLACEHOLDER a propósito: este repo es público.
DOMAIN_VPS_URL="http://TU_VPS:PUERTO"

# Email del usuario, para el registro contra el server.
DOMAIN_USER_EMAIL="vos@ejemplo.com"

# ------------------------------------------------------------
# 2. La API key: NO se persiste acá, y es deliberado
# ------------------------------------------------------------
# El propio install.env generado lleva escrito "API_KEY no se guarda acá por
# seguridad". Los hooks la resuelven en este orden — el primero que aparece gana:
#
#   1. la variable de entorno DOMAIN_API_KEY          <-- lo recomendado
#   2. ~/.config/domain/install.env                   (este archivo)
#   3. ~/.claude/.env                                 } los escribe
#   4. ~/.config/opencode/.env                        } domain-install, en 0600
#
# Los dos últimos NO se crean a mano: los genera el instalador al configurar cada
# cliente. Si los editás, ojo con el modo.
#
# El parser acepta DOMAIN_MCP_API_KEY como alias de DOMAIN_API_KEY: es el nombre
# con el que se escribe en los .env de los clientes.
# DOMAIN_API_KEY="dk_..."

# ------------------------------------------------------------
# 3. Ajustes opcionales de los hooks
# ------------------------------------------------------------

# Cuánto contexto inyecta el hook SessionStart, en bytes. Por encima de esto el
# bloque se recorta y aparece la marca "… [recortado por DOMAIN_CTX_MAX_BYTES]".
# Default: 12000.
# DOMAIN_CTX_MAX_BYTES=12000

# ------------------------------------------------------------
# 4. Solo para el bootstrap, y solo en Linux/macOS
# ------------------------------------------------------------
# bootstrap.ps1 (Windows) SIEMPRE compila con `go build` y no lee ninguna de las
# dos: ahí no hay descarga del binario publicado.

# Repo del que se baja el binario publicado. Default: nunezlagos/domain.
# DOMAIN_REPO="nunezlagos/domain"

# En "1", ignora el binario publicado y compila desde el fuente. Efecto que no es
# evidente: un binario compilado localmente se declara versión "dev" y por lo tanto
# queda FUERA de la comparación de versiones del aviso de actualización.
# DOMAIN_INSTALL_FROM_SOURCE=0
