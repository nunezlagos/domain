// DOMAINSERV-81: Grafana Alloy scrapea logs de los contenedores Docker y los
// empuja a Loki. Labels de baja cardinalidad (container, env) — alinea con la
// policy low-cardinality-metrics. Config validada con context7 /grafana/loki.
//
// DOMAINSERV-127: el host es el socket-proxy por TCP, no el socket del host.
// TIENE que ser tcp:// y no http://: con http/https Alloy arma un http.Client
// con Timeout = refresh_interval (docker.go:300-309 de v1.5.0) y eso corta el
// stream de /containers/<id>/logs?follow=1 cada 10s. Con tcp:// usa el
// transporte del cliente de Docker, sin timeout.

// DOMAINSERV-150: el discovery ve TODOS los containers del host, no solo los de
// este stack. En el VPS conviven proyectos ajenos (rds-*, qs-*) cuyos logs viejos
// Loki rechaza en bucle con "timestamp too old" contra su ventana de retención
// (DOMAINSERV-128), llenando el log de errores que no son accionables.
// Se acota el discovery, no se ensancha la ventana: este stack observa lo suyo,
// mismo criterio que el prefijo domain- de config-drift.sh. Si algún día se quiere
// observabilidad unificada del VPS, se relaja el keep de abajo.

// descubre contenedores vía el socket-proxy (GET /containers/json + /networks)
discovery.docker "domain" {
	host             = "tcp://socket-proxy:2375"
	refresh_interval = "10s"
}

// deja pasar SOLO los containers domain-*; los de otros proyectos ni se scrapean
discovery.relabel "domain_only" {
	targets = discovery.docker.domain.targets
	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/domain-.*"
		action        = "keep"
	}
}

// mapea el nombre del contenedor al label 'container' (sin la barra inicial)
discovery.relabel "domain" {
	targets = []
	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}
}

// colecta los logs de los contenedores descubiertos
loki.source.docker "domain" {
	host             = "tcp://socket-proxy:2375"
	targets          = discovery.relabel.domain_only.output
	forward_to       = [loki.process.domain.receiver]
	relabel_rules    = discovery.relabel.domain.rules
	refresh_interval = "10s"
}

// agrega el label estático de entorno (baja cardinalidad)
loki.process "domain" {
	stage.static_labels {
		values = {
			env = "prod",
		}
	}
	forward_to = [loki.write.domain.receiver]
}

// empuja a Loki
loki.write "domain" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
