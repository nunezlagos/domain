# ============================================================
# Domain — VPS env example
# ------------------------------------------------------------
# Copiar a .env y rellenar. NUNCA commitear .env. chmod 600 .env.
# Generar passwords con:
#   openssl rand -base64 48 | tr -d '/+=' | head -c 32
# ============================================================

# IP pública del VPS (si se accede por IP, no por dominio).
VPS_PUBLIC_IP=

# ------------------------------------------------------------
# Backend HTTP
# ------------------------------------------------------------
# Puerto interno del backend (Caddy lo proxyea en :80).
DOMAIN_HTTP_PORT=8000

# dev | staging | prod. El default efectivo (prod) lo pone el compose, que es la
# única fuente de verdad; acá va comentado para no duplicarlo. Descomentar SOLO
# para desarrollo local: con env != prod, checkOrphanPolicy deja de exigir
# flow_run_id en los agent_runs (DOMAINSERV-236).
#DOMAIN_ENV=dev

# ------------------------------------------------------------
# Postgres
# ------------------------------------------------------------
PG_VERSION=pg16
PG_PORT=5432
POSTGRES_DB=domain
POSTGRES_USER=domain
# Superuser para migrations y operaciones admin.
POSTGRES_PASSWORD=CHANGE_ME
# app_user: rol NOBYPASSRLS que usa el backend para queries normales.
APP_USER_PASSWORD=CHANGE_ME
# app_admin: rol BYPASSRLS para auth/login (cruza orgs) + audit.
APP_ADMIN_PASSWORD=CHANGE_ME

# ------------------------------------------------------------
# Cifrado at-rest de campos (pgcrypto / pgp_sym)
# ------------------------------------------------------------
# Passphrase simetrica que cifra la API key en claro at-rest (auth_api_keys.
# key_ciphertext, mig 000168). La consumen TANTO domain-mcp (Go: Issue/Rotate)
# COMO domain-admin (Django: create/mostrar key). DEBE ser identica en ambos y
# estar presente o no se pueden emitir/mostrar keys nuevas. Generar con:
#   openssl rand -base64 48 | tr -d '/+=' | head -c 32
DOMAIN_FIELD_ENC_KEY=CHANGE_ME

# Secret HMAC que firma los tokens del gate SDD (flow-token, DOMAINSERV-106).
# Sin esto el server no puede emitir tokens y el gate SDD queda insatisfacible.
# Si se deja vacío, el server lo deriva de DOMAIN_FIELD_ENC_KEY como fallback.
# El instalador lo genera idempotente. Generar manual con: openssl rand -hex 32
DOMAIN_FLOW_TOKEN_SECRET=CHANGE_ME

# ------------------------------------------------------------
# MinIO (S3 compatible para attachments)
# ------------------------------------------------------------
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=domain-admin
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_DEFAULT_BUCKET=domain-attachments

# Base con la que se FIRMAN las presigned URLs que consume el cliente MCP
# (DOMAINSERV-214). Es un valor propio del ambiente: no tiene default en el
# compose a propósito, porque no hay uno sensato.
#
# El endpoint interno (http://minio:9000) sirve para que el server le hable a
# MinIO, pero es un hostname de la red docker y ningún cliente externo lo
# resuelve. Con esta variable vacía el presign cae al interno y toda URL emitida
# queda inservible fuera del VPS.
#
# Llenarla exige exponer MinIO primero: el compose de minio usa `expose` y no
# `ports`, y el Caddyfile no rutea a minio:9000. Con MinIO cerrado, un valor acá
# solo cambia "could not resolve host" por "connection refused".
# Si se expone, el presign debe firmarse con este host y SIN reescribir el path:
# SigV4 firma host + path, así que un strip de prefijo en el proxy invalida la
# firma.
DOMAIN_S3_PUBLIC_ENDPOINT=

# ------------------------------------------------------------
# Backups (REQ-66)
# ------------------------------------------------------------
# Passphrase para encriptar dumps con GPG (opcional; si no se usa GPG,
# el script actual no la consume — queda para fase 2).
BACKUP_GPG_PASSPHRASE=CHANGE_ME
# Días de retención del backup diario en /opt/services/backups/postgres/.
BACKUP_DAILY_RETAIN=7

# ------------------------------------------------------------
# Notificaciones operativas (alertas de cron, fallos, etc.)
# ------------------------------------------------------------
# En ntfy.sh el topic ES la credencial: cualquiera que lo sepa puede LEER las
# alertas y PUBLICAR en el canal. Usar un valor aleatorio, no un nombre adivinable
# tipo "domain-alertas":
#   echo "NTFY_TOPIC=domain-$(openssl rand -hex 12)"
# Si queda vacío las notificaciones se omiten y el healthcheck del timer detecta
# sin poder avisar — install.sh lo reclama con un warn al habilitar los timers.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# ------------------------------------------------------------
# Grafana (REQ-70 — stack de monitoring opcional)
# ------------------------------------------------------------
# DOMAINSERV-123: Grafana ya NO se publica a internet. Escucha solo en loopback,
# se llega por tunel SSH:  ssh -L 3000:localhost:3000 <host>  y despues
# http://localhost:3000. Antes iba en 0.0.0.0:3000 sin TLS y la password de admin
# viajaba en claro.
# Sin GRAFANA_ADMIN_PASSWORD el compose FALLA a proposito (antes defaulteaba a
# "admin", o sea admin/admin expuesto a internet).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# ------------------------------------------------------------
# Postura de seguridad (DOMAINSERV-120)
# ------------------------------------------------------------
# Puertos publicados a internet que estan expuestos A PROPOSITO. install.sh revisa
# los puertos en 0.0.0.0 tras el deploy: aborta si un container domain-* publica
# algo fuera de 80/443, y avisa por los de otros proyectos en el mismo host.
# Declarar una excepcion acá la vuelve auditable y, sobre todo, hace que un puerto
# NUEVO sin declarar SI se reporte.
#
# Ejemplo (RDS propio, accedido en remoto):
#   SECURITY_ALLOWED_PUBLIC_PORTS=6300,6301,6302,6303
#
# Ojo: declarar NO es proteger. Un puerto acá sigue alcanzable desde internet; su
# defensa es el baneo por comportamiento (DOMAINSERV-124/130), no este listado.
SECURITY_ALLOWED_PUBLIC_PORTS=

# ------------------------------------------------------------
# CrowdSec: bouncer que APLICA los baneos (DOMAINSERV-124)
# ------------------------------------------------------------
# Hoy CrowdSec corre en MODO DETECCIÓN: `cscli decisions list` muestra lo que
# decidió, pero nadie lo ejecuta. El bouncer es quien corta, y vive dentro de
# Caddy — por eso necesita la imagen con plugins (services/caddy/Dockerfile).
#
# La MISMA key la usan los dos lados: Caddy para autenticarse contra la LAPI, y
# domain-crowdsec para registrar el bouncer (BOUNCER_KEY_caddy). Un solo secreto.
# install.sh la genera si falta.
#
# ACTIVAR EL BANEO ES UNA SECUENCIA DE 4 PASOS, EN ESTE ORDEN. Saltear uno deja
# el borde HTTP sin arrancar, porque la directiva `crowdsec` no existe en la
# imagen oficial:
#   1. definir esta variable (o dejar que install.sh la genere)
#   2. cd services/caddy && docker build -t domain-caddy:plugins .
#   3. descomentar el bloque `crowdsec { }` + `order crowdsec first` del Caddyfile
#      y la directiva `crowdsec` de cada site block
#   4. apuntar services/caddy/docker-compose.yml a domain-caddy:plugins
#
# ANTES del paso 3, correr `unban.sh allow-me` en el VPS para que tu IP quede en
# la whitelist. Con el bouncer activo, un auto-baneo te saca del HTTP (el SSH
# nunca se corta: el bouncer es solo HTTP, así que unban.sh siempre es alcanzable).
CROWDSEC_BOUNCER_API_KEY=

# Credenciales de la MÁQUINA CrowdSec (distintas de la API key del bouncer: el
# bouncer consulta decisiones, la máquina las produce). Viven en el .env del VPS
# desde el install original y faltaban acá, así que un install fresco no las
# generaba y el LAPI quedaba sin máquina registrada. Medido con el drift check de
# la policy default-de-env-var-va-en-el-compose el 2026-08-04.
# Van al .env y no al compose porque son secretos: un default para una password
# es peor que su ausencia.
DOMAIN_CROWDSEC_MACHINE_ID=
DOMAIN_CROWDSEC_MACHINE_PASSWORD=

# ------------------------------------------------------------
# Embeddings (REQ-68)
# ------------------------------------------------------------
# Provider para vectores en observations/knowledge_docs.
#   noop   → búsqueda semántica desactivada (RAG cae a FTS). Default.
#   fake   → determinístico, solo para tests E2E.
#   ollama → local, sin API key (servicio services/ollama). RECOMENDADO.
#   openai → requiere DOMAIN_OPENAI_API_KEY.
#   voyage → requiere DOMAIN_VOYAGE_API_KEY.
#
# DIMENSIÓN (DOMAINSERV-80 H2): el esquema pgvector es vector(1024) desde la
# migración 000275. El server MIDE la dimensión real del modelo al arrancar y,
# si no da 1024 exacto, degrada a noop y lo loguea — no rompe, pero la
# semántica queda apagada. Modelos compatibles verificados: bge-m3 (1024,
# multilingüe) y mxbai-embed-large (1024, solo inglés). NO sirven de una:
# nomic-embed-text (768), text-embedding-3-small (1536), voyage-3 (1024 real
# pero por API paga). Cambiar de dimensión implica migración + re-backfill.
DOMAIN_EMBEDDING_PROVIDER=noop
DOMAIN_OLLAMA_URL=http://ollama:11434
DOMAIN_OLLAMA_EMBED_MODEL=bge-m3

# ------------------------------------------------------------
# Query cache MCP (REQ-67)
# ------------------------------------------------------------
# El backend cachea respuestas READ de los tools MCP por 5-15s con
# invalidación por org en cada escritura. Para desactivarlo:
#   DOMAIN_DISABLE_CACHE=1
DOMAIN_DISABLE_CACHE=

# ------------------------------------------------------------
# Métricas Prometheus (REQ-70)
# ------------------------------------------------------------
# Si está activo, el backend expone /metrics en :9090 en la red
# interna de Docker para que Prometheus lo scrapee.
DOMAIN_METRICS_ENABLED=true
DOMAIN_METRICS_BIND=0.0.0.0
DOMAIN_METRICS_PORT=9090

# ------------------------------------------------------------
# Métricas de skills (DOMAINSERV-174)
# ------------------------------------------------------------
# El aggregator (hourly) y el rollup (daily) llenan skill_metrics_daily/weekly,
# de donde el portal saca las columnas Calls y Success de cada skill. Si el cron
# no corre, nadie escribe esas tablas y el portal solo puede mostrar guiones.
# No usa LLM: son 2 queries por skill por hora.
# El compose de domain-mcp ya defaultea a true, así que esta clave solo hace
# falta para APAGARLO (=false).
DOMAIN_SKILL_METRICS_ENABLED=true

# ------------------------------------------------------------
# CORS (cuando el dashboard llama al backend desde otro origen)
# ------------------------------------------------------------
# Lista separada por comas. Vacío = CORS desactivado (mismo origen).
DOMAIN_CORS_ORIGINS=

# ------------------------------------------------------------
# Frontend admin (REQ-74)
# ------------------------------------------------------------
# Base URL que usa el dashboard Angular para llamar a la API.
# Vacío = mismo origen (Caddy proxyea /api/* al backend). Solo cambiar
# si el dashboard se sirve desde un host separado.
API_URL=

# ------------------------------------------------------------
# SMTP (opcional — para alertas de uso y notificaciones futuras; NO se usa para OTP)
# ------------------------------------------------------------
# Si DOMAIN_SMTP_HOST está vacío, los emails NO se envían (NopMailer).
DOMAIN_SMTP_HOST=
DOMAIN_SMTP_PORT=587
DOMAIN_SMTP_AUTH=plain
DOMAIN_SMTP_USER=
DOMAIN_SMTP_PASSWORD=
DOMAIN_SMTP_TLS=true
DOMAIN_SMTP_FROM=no-reply@domain.local

# ------------------------------------------------------------
# Admin dashboard (HU-47.1 — login single-user)
# ------------------------------------------------------------
# Credenciales master del login del dashboard Django.
# install.sh rota ADMIN_PASSWORD: está en el mapa CREDS.
#
# El literal q1w2e3r4 se mantiene ACÁ A PROPÓSITO y no se cambia por CHANGE_ME:
# install.sh detecta un valor sin rotar comparando el .env contra ESTE archivo, y
# los .env de instalaciones previas tienen exactamente q1w2e3r4. Reemplazarlo por
# CHANGE_ME haría que esas instalaciones dejen de matchear y nunca se roten.
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=q1w2e3r4
# Firma las cookies de sesión de Django. La sesión ES la autenticación del panel
# (signed_cookies + session["authenticated"]), así que quien tenga esta clave
# puede forjar una sesión válida sin pasar por el login. Sin ella el container
# NO arranca, a propósito: un default acá es un bypass de auth.
DJANGO_SECRET_KEY=CHANGE_ME
# Client ID de Google OAuth (login con Gmail). Crear credencial en
# https://console.cloud.google.com/apis/credentials → OAuth 2.0 Web.
# Origen JS autorizado: http://<IP-del-VPS>
# URI de redirección: http://<IP-del-VPS>/login/google/
# Vacío = el botón Gmail no se muestra.
GOOGLE_CLIENT_ID=

# ------------------------------------------------------------
# Chat IA / LLM (HU-49.1 — provider MiniMax por default)
# ------------------------------------------------------------
# Provider LLM para el chat IA. Opciones:
#   (vacío)   → opencode (cerebro server-side vía sidecar, DOMAINSERV-62) si
#               DOMAIN_OPENCODE_URL está seteada. RECOMENDADO.
#   minimax   → endpoint Anthropic-compatible.
#   anthropic → Anthropic directo (requiere ANTHROPIC_API_KEY).
# DEJAR VACÍO para que opencode sea el default. Setear un valor lo saltea.
LLM_PROVIDER=

# API key del LLM (PRIMARIA, nombre genérico). La consumen Go y Django.
# Por default apunta al endpoint Anthropic-compatible de MiniMax: usar la
# Token Plan API Key de MiniMax (empieza con sk-cp-).
# Si falta, las features LLM degradan (no se registran).
LLM_API_KEY=sk-cp-CHANGE_ME
# Modelo del LLM (PRIMARIA). Default: MiniMax-M3 (1M context, extended thinking).
LLM_MODEL=MiniMax-M3

# --- Aliases DEPRECADOS (compat). Solo se usan si LLM_API_KEY/LLM_MODEL no están. ---
# Orden de fallback de la key:  LLM_API_KEY → MINIMAX_API_KEY → DOMAIN_MINIMAX_API_KEY (solo Go).
# Orden de fallback del modelo: LLM_MODEL   → MINIMAX_MODEL   → default "MiniMax-M3".
# MINIMAX_API_KEY=sk-cp-CHANGE_ME
# MINIMAX_MODEL=MiniMax-M3

# Region: international (api.minimax.io) | china (api.minimaxi.com)
MINIMAX_REGION=international
# Override del base URL (opcional, solo para proxy/self-hosted).
# MINIMAX_BASE_URL=https://api.minimax.io/anthropic

# Anthropic (fallback). Solo si LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Basic auth del sidecar opencode (DOMAINSERV-62). El usuario y la URL los
# defaultea el compose; la password la genera install.sh como el resto de los
# secretos, así que dejarla vacía acá es lo correcto — un valor literal se
# desplegaría tal cual (el incidente de GRAFANA_ADMIN_PASSWORD en CHANGE_ME).
OPENCODE_SERVER_PASSWORD=

# Cerebro server-side opencode (DOMAINSERV-62/64)
# ------------------------------------------------------------
# opencode corre como sidecar (`opencode serve`) y domain-mcp lo usa como
# provider LLM default. El provider Go se registra solo si DOMAIN_OPENCODE_URL
# está seteada; con LLM_PROVIDER vacío, queda como default.
DOMAIN_OPENCODE_URL=http://opencode:4096
# Imagen del sidecar (override si usás un mirror/tag propio).
OPENCODE_IMAGE=ghcr.io/anomalyco/opencode:latest
# HTTP basic auth del sidecar. Dejá el password vacío = server sin auth (solo
# alcanzable dentro de la red interna de docker). Setealo para protegerlo.
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
# OJO (headless): el modelo que use opencode necesita auth NO interactiva
# (API key vía las *_API_KEY de arriba), o un auth.json pre-autorizado montado.
# Modelos que exijan login OAuth interactivo NO funcionan en el sidecar.

# Worker de flows async del orquestador SDD (REQ-54 issue-54.3). Ejecuta
# server-side los flow_runs creados EXPLICITAMENTE en modo async (claim
# atomico FOR UPDATE SKIP LOCKED; jamas toca flows interactivos). Requiere
# LLM_API_KEY para que el server tenga LLM; sin key se auto-deshabilita.
# DOMAIN_ASYNC_WORKER=off              # descomentá para apagar el worker
# DOMAIN_ASYNC_WORKER_CONCURRENCY=1    # flows simultaneos (default 1)
